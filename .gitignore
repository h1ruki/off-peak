# Raw TfL datasets: only the seven audited Phase 0 CSVs are versioned.
# Downloaded archives and any other file in data/raw/ stay ignored.
data/raw/*
!data/raw/StationFootfall_2019.csv
!data/raw/StationFootfall_2020.csv
!data/raw/StationFootfall_2021.csv
!data/raw/StationFootfall_2022.csv
!data/raw/StationFootfall_2023.csv
!data/raw/StationFootfall_2024.csv
!data/raw/stationfootfall-2025-2026.csv
# Downloaded archives
*.zip
*.7z
*.rar
*.gz
*.tar

# Local temporary files and caches
.cache/
tmp/
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# Python virtual environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Environment and credential files
.env
.env.*
credentials*
secrets*
*.pem
*.key

# Power BI temporary, lock and local cache files
~$*
*.laccdb

# Power BI Project (PBIP) local files, per Microsoft's default PBIP .gitignore.
# .pbi/editorSettings.json stays tracked.
**/.pbi/localSettings.json
**/.pbi/cache.abf

# PBIX is a release artefact, attached to GitHub Releases, not tracked in history
*.pbix
