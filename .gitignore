# Raw downloaded TfL datasets and archives
data/raw/
*.zip
*.7z
*.rar
*.gz
*.tar

# Local temporary files and caches
.cache/
tmp/
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# Python virtual environments and bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Environment and credential files
.env
.env.*
credentials*
secrets*
*.pem
*.key

# Power BI temporary, lock and local cache files
~$*
*.laccdb

# Power BI Project (PBIP) local files, per Microsoft's default PBIP .gitignore.
# .pbi/editorSettings.json stays tracked.
**/.pbi/localSettings.json
**/.pbi/cache.abf

# PBIX is a release artefact, attached to GitHub Releases, not tracked in history
*.pbix
